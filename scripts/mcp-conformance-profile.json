  "description": "Application profile, not full official conformance. Raw required diagnostic failures remain failed. Every applicable official check and mapped real product test must pass; unknown or changed failures block.",
  "evidence": {
    "capabilities": {
      "file": "tests/unit/mcp-product-profile.test.ts",
      "title": "advertises only implemented capabilities and rejects unadvertised completion requests"
    },
    "callbacks": {
      "file": "tests/unit/mcp-product-profile.test.ts",
      "title": "returns only a text/structured final response without unsolicited requests or logging for real discovery calls"
    },
    "toolSchema": {
      "file": "tests/unit/mcp-catalog.test.ts",
      "title": "preserves every nested output key and required field on the SDK wire"
    },
    "toolErrors": {
      "file": "tests/unit/mcp-stations.test.ts",
      "title": "normalizes upstream failures and supplies the request signal to the wrapper"
    },
    "resources": {
      "file": "tests/unit/mcp-catalog.test.ts",
      "title": "preserves station and route JSON reads, public cache, invalid-param misses, and signals"
    },
    "prompts": {
      "file": "tests/unit/mcp-catalog.test.ts",
      "title": "returns every preserved prompt variant as one exact user text message"
    },
    "mrtr": {
      "file": "tests/unit/mcp-stations.test.ts",
      "title": "accepts a selected candidate and fetches only that station"
    },
    "tampered": {
      "file": "tests/unit/mcp-stations.test.ts",
      "title": "rejects a tampered state MAC"
    },
    "progress": {
      "file": "tests/unit/mcp-stations.test.ts",
      "title": "emits 0/2 and 1/2 progress before the final all-stations result only when tokened"
    },
    "worker": {
      "file": "tests/workers/mcp-worker.test.ts",
      "title": "serves representative modern tool, resource, and prompt calls"
    },
    "workerMrtr": {
      "file": "tests/workers/mcp-worker.test.ts",
      "title": "completes modern ambiguous-station MRTR through the assembled Worker"
    }
  },
