/**
 * Example wrangler.jsonc for self-hosting. Copy to wrangler.jsonc and
 * fill in the placeholders below.
 *
 * The original DO migration is retained only as a rollback asset. The
 * stateless route does not declare a Durable Object binding.
 *
 * Secrets are not stored here. Set WMATA_API_KEY and a stable 32+ byte
 * MCP_REQUEST_STATE_KEY with `wrangler secret put` for production and
 * preview independently.
 *
 * For local development, copy the complete canonical `.dev.vars.example`
 * template to `.dev.vars` and replace its clear placeholders. Never put
 * local-only credentials in this file.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metro-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-07",
  // Required: cloudflare/agents pulls node:async_hooks + node:diagnostics_channel;
  // a transitive mimetext dep needs node:path/os.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "keep_vars": false,
  "minify": true,
  "upload_source_maps": true,

  // Keep this original migration so the inactive rollback class can be
  // rebound without deleting its namespace.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MetroMcpAgent"]
    }
  ],

  "vars": {
    "MCP_PUBLIC_ORIGIN": "https://metro-mcp.anuragd.me",
    "MCP_ALLOWED_HOSTNAMES": "metro-mcp.anuragd.me",
    "MCP_ALLOWED_ORIGIN_HOSTNAMES": "metro-mcp.anuragd.me",
    "ENVIRONMENT": "production"
  },

  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "2026082101",
      "simple": { "limit": 300, "period": 60 }
    }
  ],

  "env": {
    "preview": {
      // Bindings and vars do not inherit into named Wrangler environments.
      "routes": [],
      "vars": {
        "MCP_PUBLIC_ORIGIN": "https://metro-mcp-preview.anuragd.me",
        "MCP_ALLOWED_HOSTNAMES": "metro-mcp-preview.anuragd.me",
        "MCP_ALLOWED_ORIGIN_HOSTNAMES": "metro-mcp-preview.anuragd.me",
        "ENVIRONMENT": "preview"
      },
      "ratelimits": [
        {
          "name": "MCP_RATE_LIMITER",
          "namespace_id": "2026082102",
          "simple": { "limit": 300, "period": 60 }
        }
      ]
    }
  },

  "assets": {
    "directory": "./public",
    // Required: the worker delegates unmatched GETs to env.ASSETS so the
    // landing page renders. Without this binding the worker throws on /.
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
      "persist": true
    }
  }
}
