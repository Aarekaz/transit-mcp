/**
 * Wrangler configuration for metro-mcp.
 *
 * The inactive MetroMcpAgent class and original migration remain in the
 * bundle for rollback, but MCP 5.x request routing is stateless and does not
 * bind the Durable Object namespace.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "313c4e6e881f1e07c880d7230541200a",
  "name": "metro-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-07",
  // Cloudflare may run several refresh Workflow steps in one invocation, and the CPU limit
  // covers the invocation: a bus timetable step inherited the previous step's use and died
  // at the 30 s default. Requests use only the CPU they need; this raises the ceiling.
  "limits": { "cpu_ms": 300000 },
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "keep_vars": false,
  "minify": true,
  "upload_source_maps": true,

  // Preserve the original namespace migration for rollback. No active
  // Durable Object binding or deletion migration is part of this cutover.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MetroMcpAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RegionFeedHub"]
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "REGION_FEED_HUB",
        "class_name": "RegionFeedHub"
      }
    ]
  },

  "r2_buckets": [
    {
      "binding": "TRANSIT_ARTIFACTS",
      "bucket_name": "transit-mcp-artifacts"
    }
  ],

  // Edge schedule refresh: the cron detects a changed source, this rebuilds it.
  "workflows": [
    {
      "name": "transit-refresh",
      "binding": "TRANSIT_REFRESH",
      "class_name": "TransitRefreshWorkflow"
    }
  ],

  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "vars": {
    "MCP_PUBLIC_ORIGIN": "https://transitmcp.com",
    "MCP_ALLOWED_HOSTNAMES": "transitmcp.com,metro-mcp.anuragd.me",
    "MCP_ALLOWED_ORIGIN_HOSTNAMES": "transitmcp.com,metro-mcp.anuragd.me",
    "SFBAY_MODE": "on",
    // DC/NYC global tools: off | dark (ingest and validate only) | on | suspended.
    "TRANSIT_COVERAGE_MODES": "{\"dc\":\"on\",\"nyc\":\"on\"}",
    // SF Bay is too large for the whole-feed journey search; it plans only through the
    // network planner below, and says PLANNING_UNAVAILABLE until its compact bands exist.
    "TRANSIT_PLANNING_OFF": "[\"sfbay\"]",
    // plan_trip searches the whole network (buses included) over compact timetables the
    // cron builds into compact/<coverage>/ in R2; without them it plans as before.
    "TRANSIT_NETWORK_PLANNING": "[\"dc\",\"nyc\",\"sfbay\"]",
    "ENVIRONMENT": "production"
  },

  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "2026082101",
      "simple": { "limit": 300, "period": 60 }
    }
  ],

  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "mcp_usage"
    }
  ],

  "env": {
    "preview": {
      // Preview uses its independently approved custom domain and never
      // inherits or reassigns the production domain.
      "routes": [
        {
          "pattern": "metro-mcp-preview.anuragd.me",
          "custom_domain": true
        }
      ],
      "vars": {
        "MCP_PUBLIC_ORIGIN": "https://metro-mcp-preview.anuragd.me",
        "MCP_ALLOWED_HOSTNAMES": "metro-mcp-preview.anuragd.me",
        "MCP_ALLOWED_ORIGIN_HOSTNAMES": "metro-mcp-preview.anuragd.me",
        "SFBAY_MODE": "dark",
        "ENVIRONMENT": "preview"
      },
      "ratelimits": [
        {
          "name": "MCP_RATE_LIMITER",
          "namespace_id": "2026082102",
          "simple": { "limit": 300, "period": 60 }
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "REGION_FEED_HUB",
            "class_name": "RegionFeedHub"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "TRANSIT_ARTIFACTS",
          "bucket_name": "transit-mcp-artifacts-preview"
        }
      ],
      "workflows": [
        {
          "name": "transit-refresh-preview",
          "binding": "TRANSIT_REFRESH",
          "class_name": "TransitRefreshWorkflow"
        }
      ],
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "mcp_usage"
        }
      ]
    }
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The asset layer answers a Range request with the whole file; the Worker answers 206.
    "run_worker_first": ["/og-video.mp4"]
  },

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.25,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
      "persist": true
    }
  },

  "routes": [
    {
      "pattern": "metro-mcp.anuragd.me",
      "custom_domain": true
    },
    {
      "pattern": "transitmcp.com",
      "custom_domain": true
    }
  ]
}
