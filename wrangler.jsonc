/**
 * Wrangler configuration for metro-mcp.
 *
 * Migrated from wrangler.toml to wrangler.jsonc in 4.0.0 alongside the
 * Durable Objects rearchitect. JSONC gives us IDE schema validation and
 * inline comments without the indent-sensitivity of TOML nested tables.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "313c4e6e881f1e07c880d7230541200a",
  "name": "metro-mcp",
  "main": "src/index.ts",
  // 2026-04-07 enables the runtime auto-Close-reply behavior for
  // hibernatable WebSockets used by McpAgent's transport.
  "compatibility_date": "2026-04-07",
  // nodejs_compat: cloudflare/agents pulls node:async_hooks +
  // node:diagnostics_channel; a transitive mimetext dep needs node:path/os.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "minify": true,
  "upload_source_maps": true,

  // Durable Objects host the MCP session, transport, and event store.
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_SESSION",
        "class_name": "MetroMcpAgent"
      }
    ]
  },

  // First-time migration creating the SQLite-backed DO namespace.
  // `new_sqlite_classes` is required for new namespaces — it enables
  // ctx.storage.sql which DurableObjectEventStore needs for resumability.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MetroMcpAgent"]
    }
  ],

  "kv_namespaces": [
    {
      "binding": "OAUTH_CLIENTS",
      "id": "44f6224b68354c24bf071e2b53b13dbb",
      "preview_id": "7d10b069531a459cb56ed59220ede55b"
    },
    {
      "binding": "RATE_LIMIT_KV",
      "id": "93885a8c949b4298a7d866e2cef408b3",
      "preview_id": "7cbeddccb3a94346b4452f40bc692b39"
    }
    // MCP_SESSIONS KV binding removed — sessions now live in MCP_SESSION DO.
    // Existing KV namespace can be deleted once in-flight sessions drain (24h TTL).
  ],

  "vars": {
    "GITHUB_CLIENT_ID": "Ov23liGFwmOZeECJ6yeN",
    "OAUTH_REDIRECT_URI": "https://metro-mcp.anuragd.me/callback"
  },

  "assets": {
    "directory": "./public",
    // Expose the assets fetcher on env.ASSETS so the worker can delegate
    // unmatched GETs (e.g. `/`) to the static landing page.
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.25,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
      "persist": true
    }
  },

  "routes": [
    {
      "pattern": "metro-mcp.anuragd.me",
      "custom_domain": true
    }
  ]
}
