/**
 * Wrangler configuration for metro-mcp.
 *
 * The inactive MetroMcpAgent class and original migration remain in the
 * bundle for rollback, but MCP 5.x request routing is stateless and does not
 * bind the Durable Object namespace.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "313c4e6e881f1e07c880d7230541200a",
  "name": "metro-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-07",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "keep_vars": false,
  "minify": true,
  "upload_source_maps": true,

  // Preserve the original namespace migration for rollback. No active
  // Durable Object binding or deletion migration is part of this cutover.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MetroMcpAgent"]
    }
  ],

  "vars": {
    "MCP_PUBLIC_ORIGIN": "https://metro-mcp.anuragd.me",
    "MCP_ALLOWED_HOSTNAMES": "metro-mcp.anuragd.me",
    "MCP_ALLOWED_ORIGIN_HOSTNAMES": "metro-mcp.anuragd.me",
    "ENVIRONMENT": "production"
  },

  "env": {
    "preview": {
      // Preview uses its independently approved custom domain and never
      // inherits or reassigns the production domain.
      "routes": [
        {
          "pattern": "metro-mcp-preview.anuragd.me",
          "custom_domain": true
        }
      ],
      "vars": {
        "MCP_PUBLIC_ORIGIN": "https://metro-mcp-preview.anuragd.me",
        "MCP_ALLOWED_HOSTNAMES": "metro-mcp-preview.anuragd.me",
        "MCP_ALLOWED_ORIGIN_HOSTNAMES": "metro-mcp-preview.anuragd.me",
        "ENVIRONMENT": "preview"
      }
    }
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.25,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
      "persist": true
    }
  },

  "routes": [
    {
      "pattern": "metro-mcp.anuragd.me",
      "custom_domain": true
    }
  ]
}
