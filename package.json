{
  "name": "metro-mcp",
  "version": "6.0.0",
  "type": "module",
  "description": "MCP server for US transit systems (DC Metro, NYC Subway) on Cloudflare Workers",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run build:apps && wrangler dev",
    "deploy": "bun run build:apps && wrangler deploy",
    "build:apps": "vite build --config vite.apps.config.ts",
    "build": "bun run build:apps && bun run type-check",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:apps": "playwright test --config playwright.apps.config.ts",
    "test": "bun run build:apps && bun run test:unit && bun run test:workers",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "bun run type-check",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit && tsc -p apps/transit-board/tsconfig.json --noEmit && tsc -p tests/apps/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.20.1",
    "gtfs-realtime-bindings": "^1.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.16.20",
    "@cloudflare/workers-types": "^4.20241218.0",
    "@modelcontextprotocol/conformance": "0.2.0-alpha.11",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@playwright/test": "1.62.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "happy-dom": "20.11.6",
    "typescript": "^5.6.3",
    "vite": "8.2.1",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.10",
    "wrangler": "4.122.0"
  },
  "keywords": [
    "mcp",
    "metro",
    "subway",
    "transit",
    "wmata",
    "mta",
    "dc",
    "nyc",
    "washington",
    "new-york",
    "cloudflare-workers",
    "gtfs",
    "real-time"
  ],
  "author": "Anurag Dhungana",
  "homepage": "https://anuragd.me",
  "license": "MIT"
}
